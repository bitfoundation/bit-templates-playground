                "ASPNETCORE_URLS": "http://*:5250"
            }
        },
        "Docker": {
            "commandName": "SdkContainer",
            "launchBrowser": true,
            "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/scalar",
            "DockerfileRunArguments": "-v C:\\DockerVolumes\\E2CB5677-5539-49C9-AFFA-977AA706B293:/container_volume",
            "environmentVariables": {
                "ASPNETCORE_HTTP_PORTS": "5250",
                "ConnectionStrings__sqlite": "Data Source=/container_volume/App_Data/Bit.TemplatePlaygroundDb.db;"
            },
            "publishAllPorts": true,
            "useSSL": false,
            "httpPort": 5250
        },
        "IIS Express": {
            "commandName": "IISExpress",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        "IIS": {
            "commandName": "IIS",
            "launchBrowser": true,
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    },
    "iisSettings": {
        "windowsAuthentication": false,
        "anonymousAuthentication": true,
        "iis": {
            "applicationUrl": "http://localhost:5250/"
        },
        "iisExpress": {
            "applicationUrl": "http://localhost:5250/"
        }
    },
    "$schema": "http://json.schemastore.org/launchsettings.json"
