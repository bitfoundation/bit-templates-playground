{
    // [mirror] the Docker profile is kept in sync with:
    // - src/Server/Bit.TemplatePlayground.Server.Web/Properties/launchSettings.json
    "profiles": {
        "Bit.TemplatePlayground.Server.Api": {
            "commandName": "Project",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5270;http://*:5270"
        },
        "WSL": {
            "commandName": "WSL2",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5270;http://*:5270"
            }
        },
        "Docker": {
            "commandName": "SdkContainer",
            "launchBrowser": true,
            "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/scalar",
            "DockerfileRunArguments": "-v C:\\DockerVolumes\\6677C159-204A-4DB6-8787-2CCCEF43F9AC:/container_volume",
            "environmentVariables": {
                "ConnectionStrings__sqlite": "Data Source=/container_volume/App_Data/Bit.TemplatePlaygroundDb.db;",
                "ASPNETCORE_HTTP_PORTS": "5270"
            },
            "publishAllPorts": true,
            "useSSL": false,
            "httpPort": 5270
        },
        "IIS Express": {
            "commandName": "IISExpress",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        "IIS": {
            "commandName": "IIS",
            "launchBrowser": true,
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    },
    "iisSettings": {
        "windowsAuthentication": false,
        "anonymousAuthentication": true,
        "iis": {
            "applicationUrl": "http://localhost:5270/"
        },
        "iisExpress": {
            "applicationUrl": "http://localhost:5270/"
        }
    },
    "$schema": "http://json.schemastore.org/launchsettings.json"
}
