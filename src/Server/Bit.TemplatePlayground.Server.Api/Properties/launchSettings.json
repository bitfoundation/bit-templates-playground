{
    // [mirror] the Docker profile is kept in sync with:
    // - src/Server/Bit.TemplatePlayground.Server.Web/Properties/launchSettings.json
    "profiles": {
        "Bit.TemplatePlayground.Server.Api": {
            "commandName": "Project",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            },
            "dotnetRunMessages": true,
            "applicationUrl": "http://localhost:5044;http://*:5044"
        },
        "WSL": {
            "commandName": "WSL2",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5044;http://*:5044"
            }
        },
        "Docker": {
            "commandName": "SdkContainer",
            "launchBrowser": true,
            "launchUrl": "{Scheme}://{ServiceHost}:{ServicePort}/scalar",
            "DockerfileRunArguments": "-v C:\\DockerVolumes\\ACCF4E6A-05F7-420E-AFED-9BF9179430F9:/container_volume",
            "environmentVariables": {
                "ConnectionStrings__sqlite": "Data Source=/container_volume/App_Data/Bit.TemplatePlaygroundDb.db;",
                "ASPNETCORE_HTTP_PORTS": "5044"
            },
            "publishAllPorts": true,
            "useSSL": false,
            "httpPort": 5044
        },
        "IIS Express": {
            "commandName": "IISExpress",
            "launchBrowser": true,
            "launchUrl": "scalar",
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        },
        "IIS": {
            "commandName": "IIS",
            "launchBrowser": true,
            "environmentVariables": {
                "ASPNETCORE_ENVIRONMENT": "Development"
            }
        }
    },
    "iisSettings": {
        "windowsAuthentication": false,
        "anonymousAuthentication": true,
        "iis": {
            "applicationUrl": "http://localhost:5044/"
        },
        "iisExpress": {
            "applicationUrl": "http://localhost:5044/"
        }
    },
    "$schema": "http://json.schemastore.org/launchsettings.json"
}
