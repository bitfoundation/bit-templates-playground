<AppErrorBoundary @key="softRestartKey">
    <CascadingAuthenticationState>
        <AppClientCoordinator />
        <LayoutView Layout="@(Layout ?? typeof(MainLayout))">
            <AppRouter AppAssembly="@GetType().Assembly"
                       AdditionalAssemblies="@(AssemblyLoadContext.Default.Assemblies.Where(asm => asm.GetName().Name?.Contains("Bit.TemplatePlayground.Client") is true))">
                <Found Context="routeData">
                    <AppRouteDataPublisher RouteData="@routeData" />
                    <AuthorizeRouteView RouteData="@routeData">
                        <Authorizing>
                            <LoadingComponent />
                        </Authorizing>
                        <NotAuthorized>
                            <NotAuthorizedPage />
                        </NotAuthorized>
                    </AuthorizeRouteView>
                </Found>
                <Navigating>
                    <LoadingComponent />
                </Navigating>
            </AppRouter>
        </LayoutView>
    </CascadingAuthenticationState>
</AppErrorBoundary>
